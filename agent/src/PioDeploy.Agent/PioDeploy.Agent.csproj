<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PioDeploy.Agent</RootNamespace>
    <AssemblyName>PioDeployAgent</AssemblyName>
    <Version>1.4.23</Version>
    <!-- Brand icon: shows on the exe in Explorer, and ships in the bundle
         (Content below) so the tray helper can use it for the tray icon. -->
    <ApplicationIcon>pio.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PioDeploy.Agent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="pio.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Pre-built tray status icons (green/red health dot). The tray helper
         loads these; composing them at runtime via GDI mangled the mascot. -->
    <Content Include="pio-green.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="pio-red.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
</Project>
